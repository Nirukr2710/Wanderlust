<div class="container mt-4">

    <h2 class="mb-4 text-center">My Bookings</h2>

    <% if(bookings.length === 0){ %>

        <div class="alert alert-info text-center">
            You haven't made any bookings yet.
        </div>

    <% } %>

    <div class="row">

        <% bookings.forEach((booking)=>{ %>

            <div class="col-md-6 col-lg-4 mb-4">

                <div class="card h-100 shadow">

                    <img
                        src="<%= booking.listing.image.url %>"
                        class="card-img-top"
                        style="height:220px; object-fit:cover;"
                    >

                    <div class="card-body">

                        <h5 class="card-title">
                            <%= booking.listing.title %>
                        </h5>

                        <p class="text-muted mb-2">
                            <i class="fa-solid fa-location-dot"></i>
                            <%= booking.listing.location %>,
                            <%= booking.listing.country %>
                        </p>

                        <hr>

                        <p>
                            <strong>Check In:</strong><br>
                            <%= booking.checkIn.toDateString() %>
                        </p>

                        <p>
                            <strong>Check Out:</strong><br>
                            <%= booking.checkOut.toDateString() %>
                        </p>

                        <p>
                            <strong>Guests:</strong>
                            <%= booking.guests %>
                        </p>

                        <p>
                            <strong>Price:</strong>
                            ₹<%= booking.listing.price %> / night
                        </p>

                        <p>
                            <strong>Status:</strong>

                            <span class="badge bg-success">
                                <%= booking.status %>
                            </span>
                        </p>

                    </div>

                    <div class="card-footer bg-white">
 <form action="/bookings/<%= booking._id %>?_method=DELETE"method="POST">
    <button class="btn btn-danger w-100"
        onclick="return confirm('Are you sure you want to cancel this booking?')">
        Cancel Booking
    </button>
 </form>
                    </div>

                </div>

            </div>

        <% }) %>

    </div>

</div>