<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
    <div class="card shadow-lg p-4 mx-auto" style="max-width:700px;">

        <div class="text-center">
            <img src="<%= user.profileImage.url %>"
                 class="rounded-circle mb-3"
                 width="120"
                 height="120"
                 style="object-fit:cover;">
        </div>

        <h2 class="text-center mb-4">My Profile</h2>

       <table class="table">
    <tr>
        <th>Username</th>
        <td><%= user.username %></td>
    </tr>

    <tr>
        <th>Email</th>
        <td><%= user.email %></td>
    </tr>

    <tr>
        <th>Role</th>
        <td><%= user.role %></td>
    </tr>
</table>

<div class="d-flex justify-content-between align-items-center mt-4">

    <h4 class="mb-0">
        My Wishlist
    </h4>

    <% if(user.wishlist.length > 0){ %>
        <a href="/listings/wishlist" class="btn btn-danger btn-sm">
            View Saved Listings
        </a>
    <% } %>

</div>

<% if(user.wishlist.length === 0){ %>
    <p class="text-muted mt-3">
        No listings in your wishlist.
    </p>
<% } %>

<div class="text-center mt-4">
    <a href="/profile/edit" class="btn btn-dark">
        Edit Profile
    </a>
</div>