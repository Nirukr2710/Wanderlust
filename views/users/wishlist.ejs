<% layout("/layouts/boilerplate") %>

<div class="container mt-4">
    <h1 class="mb-4"> My Wishlist</h1>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <!-- g-4 -->
        <% for(let listing of listings){ %>

        <div class="col">
            <!-- col-lg-4 col-md-6 -->
            <div class="card wishlist-card">
             <img src="<%= listing.image.url %>" class="wishlist-img" alt="listing image" >
              <div class="card-body">
                    <h5 class="wishlist-title"><%= listing.title %></h5>
                    <p class="wishlist-price">
                        ₹<%= listing.price.toLocaleString("en-IN") %> / night
                    </p>
                    <!-- <a href="/listings/<%= listing._id %>" class="btn btn-dark view-btn" >
                        View Details
                    </a> -->
                    <div class=" wishlist-actions">
                   <a href="/listings/<%= listing._id %>" class="btn btn-dark"> View</a>
                   <form  action="/listings/<%= listing._id %>/wishlist?_method=DELETE" method="POST">
                  <button class="btn btn-danger"> Remove</button>
                  </form>

                </div>
             </div>

        </div>
    </div>

        <% } %>
    </div>
</div>